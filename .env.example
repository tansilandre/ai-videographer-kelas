# AI Videographer settings. Copy to .env (same folder) and fill in.
# .env is git-ignored. Never commit it, never paste the key into chat or a prompt.
# Only the human edits this file. An agent should only ever read it indirectly via `vg doctor`,
# never change a value here itself — a cap refusal means ask the human, not raise the number.
# install.sh sets this file to chmod 600 (owner read/write only) and `vg doctor` warns if it is
# readable by other users.

# kie.ai API key: https://kie.ai/api-key
# Tip: create a dedicated key for this harness and give it a total credit cap there.
KIE_API_KEY=

# OpenRouter API key: https://openrouter.ai/keys
# Used only by `vg audio voice` and `vg audio music` (narration and music, a few cents per take).
OPENROUTER_API_KEY=

# Credit safety (enforced by the vg tool). These are read from this file only;
# environment variables cannot override them.
# max credits one project may commit in total
VG_BUDGET_PROJECT=800
# max credits a single request may cost
VG_MAX_PER_CALL=250

# Who approves video spend:
#   terminal = the human types a one-time code in their own terminal (default; agents cannot)
#   chat     = the agent records approval after a yes in chat (weaker; for setups with no terminal)
# Never run `vg approve` through script, expect, a pty, tmux or any terminal an agent controls;
# only the human types the code. An agent may open the command in the human's own terminal panel
# for them, but the human types the code. This is friction against accidental approval, not a
# wall — the real hard limit is a dedicated kie.ai key with its own total credit cap.
VG_APPROVAL_MODE=terminal

# Default models (ids from 2_Tools/vg/models/)
VG_IMAGE_MODEL=gpt-image-2
VG_VIDEO_MODEL=veo-3-1-lite
