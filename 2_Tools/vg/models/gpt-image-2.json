{
  "id": "gpt-image-2",
  "kind": "image",
  "provider": "kie",
  "status": "live-tested",
  "notes": "OpenAI GPT Image 2 on kie.ai. One image per task, no seed. Verified 2026-09-24 (docs + live).",
  "variants": {
    "t2i": { "model": "gpt-image-2-text-to-image" },
    "i2i": { "model": "gpt-image-2-image-to-image", "refs_field": "input_urls", "max_refs": 16 }
  },
  "prompt_max": 20000,
  "params": {
    "aspect_ratio": {
      "type": "string",
      "enum": ["auto", "1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5", "16:9", "9:16", "2:1", "1:2", "3:1", "1:3", "21:9", "9:21"],
      "default": "9:16"
    },
    "resolution": { "type": "string", "enum": ["1K", "2K", "4K"], "default": "2K" }
  },
  "constraints": [
    { "when": { "resolution": "2K" }, "forbid": { "aspect_ratio": ["5:4", "4:5", "3:1", "1:3", "9:21"] } },
    { "when": { "resolution": "4K" }, "forbid": { "aspect_ratio": ["3:1", "1:3", "9:21", "1:1"] } },
    { "when": { "aspect_ratio": "auto" }, "forbid": { "resolution": ["2K", "4K"] } }
  ],
  "pricing": { "keys": ["resolution"], "table": { "1K": 6, "2K": 10, "4K": 16 } }
}
